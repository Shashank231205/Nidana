# Nidana — environment template. Copy to .env. Never commit .env.

# --- Database ---
NIDANA_DB_HOST=localhost
NIDANA_DB_PORT=5432
NIDANA_DB_NAME=nidana
NIDANA_DB_USER=nidana_app
NIDANA_DB_PASSWORD=
# Role without UPDATE/DELETE on append-only tables. Used by the application.
NIDANA_DB_WRITER_ROLE=nidana_app
# Migration-only role. Used by Alembic, never by the application.
NIDANA_DB_MIGRATOR_USER=nidana_migrator
NIDANA_DB_MIGRATOR_PASSWORD=

# --- Deployment mode ---
# development | production
# production refuses to start if any hosted inference provider is configured.
NIDANA_MODE=development

# --- Rules ---
# Release builds refuse to start when a rule with verify_before_ship=true is active.
NIDANA_ALLOW_UNVERIFIED_RULES=true

# --- Inference ---
# local is the only implemented transport. Nidana runs on-premise; hosted
# inference would send patient utterances off the machine on every turn, and
# production mode refuses to start if it is set.
NIDANA_INFERENCE_TRANSPORT=local
NIDANA_OLLAMA_HOST=http://localhost:11434

# The model to run. Pull it first: python scripts/download_models.py
#
# Sizing note. The binding constraint is VRAM, not RAM. A 7B q4_K_M model is
# roughly 4.7GB, so on a 4GB card Ollama splits layers between GPU and CPU and
# the turn is slower but works. A 9B or larger model runs almost entirely on
# CPU and will not hold the per-turn latency budget on laptop hardware.
#
# qwen2.5 is the default because the hardest requirement here is code-switched
# Hindi, Kannada, Marathi, Bengali and Tamil, and it covers those better than
# the same-sized alternatives. It also emits reliable JSON, which the
# structuring agent depends on.
NIDANA_MODEL_PRIMARY=qwen2.5:7b-instruct-q4_K_M

# Tried in order when the primary is unreachable. Smaller models are listed so
# a machine that cannot hold 7B still runs, with the eval numbers recording
# which model actually answered.
NIDANA_MODEL_FALLBACKS=llama3.1:8b-instruct-q4_K_M,qwen2.5:3b-instruct-q4_K_M

# --- ASR ---
# Local in every mode. There is no hosted transcription path.
NIDANA_ASR_MODEL_PATH=./models/asr/indicwhisper
