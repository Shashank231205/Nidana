# Corpus and knowledge index: built by scripts/build_knowledge_index.py, not
# committed. The PDFs belong to their publishers and the index is a derived
# artefact that a deployment rebuilds from the registry.
data/corpus/
data/knowledge_index.json

# Local machine setup, not the project's. Holds the CA bundle needed where a
# TLS-intercepting antivirus sits between pip and PyPI.
.local/

# Brand-to-molecule index: built by scripts/build_brand_index.py from the
# MIT-licensed source named in that script. A derived artefact, like the
# knowledge index, and 6MB of it.
services/rx/rules/brands/index.csv

# Frontend build artefacts. node_modules is restored by `npm ci` from the
# lockfile, which is committed; the tsbuildinfo files are incremental compiler
# caches and differ between machines.
node_modules/
*.tsbuildinfo
web/dist/

# Session handover notes. Working state for whoever picks the work up next,
# not documentation of the product: what it records that outlives a session
# belongs in docs/ instead.
HANDOVER.md
